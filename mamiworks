      <div class="field">
        <label>İletişim / WhatsApp Telefon *</label>
        <input type="tel" id="custPhone" placeholder="05xx xxx xx xx">
      </div>

      <!-- YENİ EKLENEN ARAÇ FOTOĞRAFI YÜKLEME ALANI -->
      <div class="field">
        <label>Kendi Aracınızın Fotoğraflarını Yükleyin *</label>
        <input type="file" id="custVehiclePhotos" accept="image/*" multiple>
        <span style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Birden fazla araç fotoğrafı seçebilirsiniz.</span>
      </div>

      <div class="field">
        <label>Özel Tasarım Notları & Detaylar</label>
        <textarea id="custNotes" rows="3" placeholder="İstediğiniz ekstra detayları veya özel taleplerinizi yazın..."></textarea>
      </div>

      <button class="cta" id="orderBtn">WhatsApp Detaylı Sipariş Gönder →</button>
    </aside>
  </main>
</div>

<!-- Admin Modal -->
<div class="modal-overlay" id="adminModal">
  <div class="modal-card">
    <button class="modal-close" id="closeModalBtn">✕</button>

    <div id="adminLoginBox">
      <h3 style="font-size: 18px; margin-bottom: 6px;">Yönetici Girişi</h3>
      <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 18px;">Ürün ve sipariş yönetimi için giriş yapın.</p>
      <div class="field">
        <label>Admin Şifresi</label>
        <input type="password" id="adminPassInput" placeholder="••••••••">
      </div>
      <button class="cta" id="adminLoginBtn">Giriş Yap</button>
    </div>

    <div id="adminControlsBox" style="display: none;">
      <div class="admin-tabs">
        <button class="tab-btn active" id="tabAddProductBtn">➕ Ürün Ekle</button>
        <button class="tab-btn" id="tabCustomerFoldersBtn">📁 Müşteri Fotoğraf Klasörleri</button>
      </div>

      <!-- TAB 1: ÜRÜN EKLE -->
      <div id="tabAddProductContent">
        <h3 style="font-size: 16px; color: var(--gold-light); margin-bottom:12px;">Yeni Tasarım Yükle</h3>
        <div class="field">
          <label>Tasarım Adı</label>
          <input type="text" id="newTitle" placeholder="Örn: Porsche Livery Tasarım">
        </div>
        <div class="field">
          <label>Fiyat (TL)</label>
          <input type="number" id="newPrice" placeholder="Örn: 2500">
        </div>
        <div class="field">
          <label>Görsel Dosyası Seç</label>
          <input type="file" id="newImgFile" accept="image/*">
        </div>
        <button class="cta" id="saveProductBtn" style="margin-top:8px;">➕ Ürünü Ekle</button>
      </div>

      <!-- TAB 2: MÜŞTERİ FOTOĞRAF KLASÖRLERİ -->
      <div id="tabCustomerFoldersContent" style="display: none;">
        <h3 style="font-size: 16px; color: var(--gold-light); margin-bottom:12px;">Gelen Müşteri Araç Fotoğrafları</h3>
        <div id="customerFoldersList"></div>
      </div>

      <button class="cta" id="adminLogoutBtn" style="margin-top:20px; background: rgba(239, 68, 68, 0.2); color:#fca5a5; border:1px solid var(--danger);">Çıkış Yap</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Firebase Realtime Database Entegrasyonu -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
  import { getDatabase, ref, set, onValue } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBy1ICxlUyynBdu2_UjZvwURHFfSelF_5A",
    authDomain: "bym-oto-yikama.firebaseapp.com",
    databaseURL: "https://bym-oto-yikama-default-rtdb.firebaseio.com",
    projectId: "bym-oto-yikama",
    storageBucket: "bym-oto-yikama.firebasestorage.app",
    messagingSenderId: "409475419804",
    appId: "1:409475419804:web:b00588b14ba94990eda759"
  };

  const app = initializeApp(firebaseConfig);
  const db = getDatabase(app);

  window.firebaseDb = db;
  window.dbRef = ref;
  window.dbSet = set;

  onValue(ref(db, 'mami_products'), (snapshot) => {
    const data = snapshot.val();
    const list = data ? Object.values(data) : [];
    localStorage.setItem("mami_products", JSON.stringify(list));
    window.PRODUCTS = list;
    if (typeof window.renderProducts === "function") window.renderProducts();
  });

  onValue(ref(db, 'mami_customer_orders'), (snapshot) => {
    const data = snapshot.val();
    const list = data ? Object.values(data) : [];
    localStorage.setItem("mami_customer_orders", JSON.stringify(list));
    window.CUSTOMER_ORDERS = list;
    if (typeof window.renderCustomerFolders === "function") window.renderCustomerFolders();
  });
</script>

<script>
const WHATSAPP_PHONE = "905385475603";
const ADMIN_PASS = "muho6060.";

let PRODUCTS = JSON.parse(localStorage.getItem("mami_products") || "[]");
let CUSTOMER_ORDERS = JSON.parse(localStorage.getItem("mami_customer_orders") || "[]");
let selectedProduct = null;

function saveProducts() {
  localStorage.setItem("mami_products", JSON.stringify(PRODUCTS));
  if (window.firebaseDb && window.dbRef && window.dbSet) {
    window.dbSet(window.dbRef(window.firebaseDb, "mami_products"), PRODUCTS);
  }
}

function saveCustomerOrders() {
  localStorage.setItem("mami_customer_orders", JSON.stringify(CUSTOMER_ORDERS));
  if (window.firebaseDb && window.dbRef && window.dbSet) {
    window.dbSet(window.dbRef(window.firebaseDb, "mami_customer_orders"), CUSTOMER_ORDERS);
  }
}

const $ = id => document.getElementById(id);

function toast(title, text=""){
  const el=$("toast"); el.innerHTML=`<b>${title}</b>${text}`; el.classList.add("show");
  clearTimeout(window.__toast); window.__toast=setTimeout(()=>el.classList.remove("show"),3200);
}

function deleteProduct(id, e) {
  e.stopPropagation();
  PRODUCTS = PRODUCTS.filter(p => p.id !== id);
  saveProducts();
  renderProducts();
  toast("Silindi", "Tasarım kaldırıldı.");
}

function deleteCustomerFolder(orderId) {
  CUSTOMER_ORDERS = CUSTOMER_ORDERS.filter(o => o.id !== orderId);
  saveCustomerOrders();
  renderCustomerFolders();
  toast("Silindi", "Müşteri klasörü ve fotoğrafları silindi.");
}

function renderProducts() {
  const grid = $("productsGrid");
  grid.innerHTML = "";
  if (!PRODUCTS || PRODUCTS.length === 0) {
    grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--text-muted);">🎨 Henüz eklenmiş tasarım yok. Admin paneline giriş yapıp görsel ekleyebilirsiniz.</div>`;
    return;
  }
  PRODUCTS.forEach(p => {
    const card = document.createElement("div");
    card.className = "product-card" + (selectedProduct && selectedProduct.id === p.id ? " selected" : "");
    card.innerHTML = `
      <button class="delete-btn" onclick="deleteProduct('${p.id}', event)">✕</button>
      <img src="${p.img}" class="product-img">
      <div class="product-body">
        <div>
          <div class="product-title">${p.title}</div>
          <div class="product-price">${Number(p.price).toLocaleString("tr-TR")} TL</div>
        </div>
        <button class="select-btn">${selectedProduct && selectedProduct.id === p.id ? "Seçildi ✓" : "Tasarımı Seç"}</button>
      </div>
    `;
    card.onclick = () => {
      selectedProduct = p;
      $("selectedProductTitle").value = p.title;
      $("selectedProductPrice").value = p.price.toLocaleString("tr-TR") + " TL";
      renderProducts();
    };
    grid.appendChild(card);
  });
}
window.renderProducts = renderProducts;

function renderCustomerFolders() {
  const listContainer = $("customerFoldersList");
  listContainer.innerHTML = "";

  if (!CUSTOMER_ORDERS || CUSTOMER_ORDERS.length === 0) {
    listContainer.innerHTML = `<p style="color:var(--text-muted); font-size:13px; text-align:center; padding:20px;">Henüz yüklenmiş müşteri araç fotoğrafı bulunmuyor.</p>`;
    return;
  }

  CUSTOMER_ORDERS.forEach(order => {
    const card = document.createElement("div");
    card.className = "order-folder-card";

    let photosHTML = "";
    if (order.photos && order.photos.length > 0) {
      photosHTML = order.photos.map(p => `<img src="${p}" class="order-photo-item" onclick="window.open('${p}', '_blank')" title="Büyütmek için tıklayın">`).join("");
    } else {
      photosHTML = `<p style="font-size:11px; color:var(--text-muted);">Fotoğraf yüklenmedi.</p>`;
    }

    card.innerHTML = `
      <div class="order-folder-header">
        <div>
          <div class="order-folder-title">📁 ${order.custName} (${order.custPhone})</div>
          <div style="font-size:11px; color:var(--text-muted);">Tarih: ${order.date} | Tasarım: <b>${order.productTitle}</b></div>
        </div>
        <button onclick="deleteCustomerFolder('${order.id}')" style="color:var(--danger); font-weight:bold; font-size:12px;">Klasörü Sil</button>
      </div>
      <div style="font-size:12px; margin-bottom:8px;"><b>Özel Notlar:</b> ${order.notes || 'Yok'}</div>
      <div style="font-size:12px; font-weight:bold; margin-bottom:4px; color:var(--gold-light);">Yüklenen Araç Fotoğrafları (${order.photos ? order.photos.length : 0} Adet):</div>
      <div class="order-photo-grid">${photosHTML}</div>
    `;

    listContainer.appendChild(card);
  });
}
window.renderCustomerFolders = renderCustomerFolders;

/* Sipariş Gönderimi & Fotoğrafların Admin Paneline Kaydedilmesi */
$("orderBtn").onclick = async () => {
  if (!selectedProduct) { toast("Tasarım Seçilmedi", "Lütfen bir tasarım seçin."); return; }
  const name = $("custName").value.trim();
  const phone = $("custPhone").value.trim();
  const notes = $("custNotes").value.trim();
  const fileInput = $("custVehiclePhotos");

  if (!name || !phone) { toast("Bilgiler Eksik", "Lütfen Ad Soyad ve Telefon numarası giriniz."); return; }

  const files = Array.from(fileInput.files);
  const photoBase64List = [];

  if (files.length > 0) {
    toast("Yükleniyor...", "Araç fotoğrafları admin paneline kaydediliyor...");
    for (const file of files) {
      const b64 = await new Promise((res) => {
        const r = new FileReader();
        r.onload = e => res(e.target.result);
        r.readAsDataURL(file);
      });
      photoBase64List.push(b64);
    }
  }

  // Sipariş verilerini ve Araç Görsellerini Klasör Olarak Kaydet
  const orderData = {
    id: "ord_" + Date.now(),
    custName: name,
    custPhone: phone,
    productTitle: selectedProduct.title,
    productPrice: selectedProduct.price,
    notes: notes,
    photos: photoBase64List,
    date: new Date().toLocaleString("tr-TR")
  };

  CUSTOMER_ORDERS.unshift(orderData);
  saveCustomerOrders();

  // WhatsApp Bilgilendirmesi
  const msg = [
    "🔥 *MAMI WORKS — YENİ TASARIM SİPARİŞİ*",
    "----------------------------------",
    `🎨 *Seçilen Tasarım:* ${selectedProduct.title}`,
    `💰 *Tasarım Tutarı:* ${selectedProduct.price.toLocaleString("tr-TR")} TL`,
    "----------------------------------",
    "👤 *MÜŞTERİ BİLGİLERİ*",
    `• *Ad Soyad:* ${name}`,
    `• *Telefon:* ${phone}`,
    "----------------------------------",
    "📷 *ARAÇ FOTOĞRAFLARI*",
    photoBase64List.length > 0 ? `• ${photoBase64List.length} Adet araç fotoğrafı Admin Panelinize Yüklendi!` : "• Fotoğraf yüklenmedi.",
    notes ? `• *Özel Notlar:* ${notes}` : "",
    "----------------------------------",
    "🚀 Sipariş detaylarımı onaylıyorum!"
  ].filter(Boolean).join("\n");

  window.open(`https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(msg)}`, "_blank");
};

/* Admin Paneli İşlemleri */
$("adminLogoBtn").onclick = () => $("adminModal").classList.add("active");
$("closeModalBtn").onclick = () => $("adminModal").classList.remove("active");

$("adminLoginBtn").onclick = () => {
  if ($("adminPassInput").value === ADMIN_PASS) {
    $("adminLoginBox").style.display = "none";
    $("adminControlsBox").style.display = "block";
    document.body.classList.add("admin-mode");
    renderProducts();
    renderCustomerFolders();
    toast("Admin Girişi", "Yönetici paneli aktif.");
  } else {
    toast("Hata", "Yanlış admin şifresi!");
  }
};

$("tabAddProductBtn").onclick = () => {
  $("tabAddProductBtn").classList.add("active");
  $("tabCustomerFoldersBtn").classList.remove("active");
  $("tabAddProductContent").style.display = "block";
  $("tabCustomerFoldersContent").style.display = "none";
};

$("tabCustomerFoldersBtn").onclick = () => {
  $("tabCustomerFoldersBtn").classList.add("active");
  $("tabAddProductBtn").classList.remove("active");
  $("tabAddProductContent").style.display = "none";
  $("tabCustomerFoldersContent").style.display = "block";
  renderCustomerFolders();
};

$("saveProductBtn").onclick = () => {
  const title = $("newTitle").value.trim();
  const price = Number($("newPrice").value);
  const fileInput = $("newImgFile");

  if (!title || !price || !fileInput.files[0]) {
    toast("Eksik Veri", "Lütfen tüm alanları doldurun ve bir görsel seçin.");
    return;
  }

  const reader = new FileReader();
  reader.onload = function(e) {
    PRODUCTS.push({ id: "p_" + Date.now(), title, price, img: e.target.result });
    saveProducts();
    renderProducts();
    $("newTitle").value = ""; $("newPrice").value = ""; $("newImgFile").value = "";
    toast("Başarılı", "Tasarım kataloğa eklendi.");
  };
  reader.readAsDataURL(fileInput.files[0]);
};

$("adminLogoutBtn").onclick = () => {
  $("adminLoginBox").style.display = "block";
  $("adminControlsBox").style.display = "none";
  document.body.classList.remove("admin-mode");
  renderProducts();
  $("adminModal").classList.remove("active");
};

/* Arka Plan Parçacık Efekti */
const canvas = $("particleCanvas");
const ctx = canvas.getContext("2d");
let particles = [];
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
window.addEventListener("resize", resizeCanvas); resizeCanvas();

class Particle {
  constructor() { this.reset(); }
  reset() {
    this.x = Math.random() * canvas.width; this.y = Math.random() * canvas.height;
    this.size = Math.random() * 2 + 0.5; this.speedX = (Math.random() - 0.5) * 0.3;
    this.speedY = (Math.random() - 0.5) * 0.3; this.opacity = Math.random() * 0.5 + 0.2;
  }
  update() {
    this.x += this.speedX; this.y += this.speedY;
    if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) this.reset();
  }
  draw() {
    ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(215, 180, 106, ${this.opacity})`; ctx.fill();
  }
}
function initParticles() { particles = []; for (let i = 0; i < 50; i++) particles.push(new Particle()); }
function animateParticles() { ctx.clearRect(0,0,canvas.width,canvas.height); particles.forEach(p => { p.update(); p.draw(); }); requestAnimationFrame(animateParticles); }
initParticles(); animateParticles();

$("themeBtn").onclick = () => {
  document.body.classList.toggle("light-theme");
  $("themeBtn").innerHTML = document.body.classList.contains("light-theme") ? "☀️ Açık Tema" : "🌙 Koyu Tema";
};

renderProducts();
