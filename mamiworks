
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MAMI WORKS — Premium Automotive Graphic & Logo Store</title>
<style>
:root {
  --bg-gradient: radial-gradient(circle at 50% 0%, #151a24 0%, #080a0e 100%);
  --panel-bg: rgba(18, 22, 31, 0.75);
  --panel-border: rgba(255, 255, 255, 0.08);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --gold-primary: #d7b46a;
  --gold-light: #f3d89d;
  --gold-glow: rgba(215, 180, 106, 0.25);
  --input-bg: rgba(0, 0, 0, 0.3);
  --input-border: rgba(255, 255, 255, 0.1);
  --danger: #ef4444;
  --radius-lg: 20px;
  --radius-md: 12px;
  --shadow-lg: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

body.light-theme {
  --bg-gradient: radial-gradient(circle at 50% 0%, #f1f5f9 0%, #e2e8f0 100%);
  --panel-bg: rgba(255, 255, 255, 0.85);
  --panel-border: rgba(0, 0, 0, 0.08);
  --text-main: #0f172a;
  --text-muted: #64748b;
  --gold-primary: #b48835;
  --gold-light: #d7b46a;
  --gold-glow: rgba(180, 136, 53, 0.2);
  --input-bg: rgba(255, 255, 255, 0.8);
  --input-border: rgba(0, 0, 0, 0.15);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  min-height: 100vh; color: var(--text-main); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg-gradient); background-attachment: fixed; line-height: 1.5; padding: 24px 16px; position: relative;
}

#particleCanvas { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 0; }
button, input, textarea { font: inherit; color: inherit; }
button { cursor: pointer; border: none; background: none; }

.app { max-width: 1200px; margin: 0 auto; position: relative; z-index: 10; }

.nav {
  display: flex; justify-content: space-between; align-items: center; padding: 12px 20px;
  background: var(--panel-bg); border: 1px solid var(--panel-border); backdrop-filter: blur(16px);
  border-radius: var(--radius-lg); margin-bottom: 24px;
}

.brand { display: flex; align-items: center; gap: 14px; }
.logo {
  width: 44px; height: 44px; border-radius: var(--radius-md); background: linear-gradient(135deg, #2a2215, #141009);
  border: 1px solid var(--gold-primary); display: flex; align-items: center; justify-content: center;
  color: var(--gold-light); font-weight: 800; font-size: 20px; box-shadow: 0 0 15px var(--gold-glow); cursor: pointer;
}

.theme-toggle {
  background: rgba(255, 255, 255, 0.05); border: 1px solid var(--panel-border); padding: 8px 14px;
  border-radius: 99px; font-size: 12px; font-weight: 600;
}

.hero {
  border: 1px solid var(--panel-border); border-radius: var(--radius-lg); padding: 36px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
  backdrop-filter: blur(12px); margin-bottom: 24px;
}
.eyebrow { color: var(--gold-primary); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }

.shop-container { display: grid; grid-template-columns: 1fr 380px; gap: 24px; }
.card { background: var(--panel-bg); border: 1px solid var(--panel-border); backdrop-filter: blur(16px); border-radius: var(--radius-lg); padding: 28px; box-shadow: var(--shadow-lg); }
.card-head { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--panel-border); }

.products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
.product-card {
  background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-md);
  overflow: hidden; transition: var(--transition); display: flex; flex-direction: column; position: relative;
}
.product-card.selected { border-color: var(--gold-primary); box-shadow: 0 0 20px var(--gold-glow); }
.product-img { width: 100%; height: 160px; object-fit: cover; background: rgba(0,0,0,0.5); border-bottom: 1px solid var(--panel-border); }
.product-body { padding: 14px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.product-title { font-size: 14px; font-weight: 700; color: var(--text-main); }
.product-price { font-size: 16px; font-weight: 800; color: var(--gold-light); margin-bottom: 12px; }

.delete-btn {
  position: absolute; top: 8px; right: 8px; background: rgba(239, 68, 68, 0.85); color: #fff;
  border-radius: 50%; width: 28px; height: 28px; display: none; align-items: center; justify-content: center; font-weight: bold;
}
body.admin-mode .delete-btn { display: flex; }

.select-btn {
  width: 100%; padding: 10px; border-radius: var(--radius-md); border: 1px solid var(--gold-primary);
  background: rgba(215, 180, 106, 0.1); color: var(--gold-light); font-weight: 700; font-size: 12px;
}
.product-card.selected .select-btn { background: var(--gold-primary); color: #080a0e; }

.field { display: flex; flex-direction: column; margin-bottom: 14px; }
label { font-size: 12px; font-weight: 600; margin-bottom: 6px; }
input, textarea {
  width: 100%; padding: 12px 14px; background: var(--input-bg); border: 1px solid var(--input-border);
  border-radius: var(--radius-md); outline: none; transition: var(--transition); font-size: 13px;
}
input[type="file"] { padding: 8px; cursor: pointer; }

.cta {
  width: 100%; height: 50px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
  color: #080a0e; font-weight: 800; font-size: 14px; box-shadow: 0 10px 20px var(--gold-glow); transition: var(--transition);
}
.cta:hover { transform: translateY(-2px); filter: brightness(1.08); }

/* Modal & Klasör Yapısı */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(12px); z-index: 9999;
  display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s ease;
}
.modal-overlay.active { opacity: 1; visibility: visible; }
.modal-card {
  width: 92%; max-width: 650px; background: var(--panel-bg); border: 1px solid var(--gold-primary);
  border-radius: var(--radius-lg); padding: 28px; max-height: 90vh; overflow-y: auto; position: relative;
}
.modal-close { position: absolute; top: 16px; right: 16px; font-size: 18px; color: var(--text-muted); }

.admin-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--panel-border); padding-bottom: 10px; }
.tab-btn { padding: 8px 16px; border-radius: var(--radius-md); font-size: 13px; font-weight: 700; color: var(--text-muted); background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border); }
.tab-btn.active { background: var(--gold-primary); color: #080a0e; border-color: var(--gold-primary); }

.order-folder-card { background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-md); padding: 16px; margin-bottom: 16px; }
.order-folder-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px solid var(--panel-border); padding-bottom: 8px; }
.order-folder-title { font-size: 15px; font-weight: 800; color: var(--gold-light); }
.order-photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; margin-top: 10px; }
.order-photo-item { width: 100%; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid var(--panel-border); cursor: pointer; transition: var(--transition); }
.order-photo-item:hover { transform: scale(1.05); border-color: var(--gold-primary); }

.toast {
  position: fixed; bottom: 24px; right: 24px; z-index: 10000; background: var(--panel-bg); border: 1px solid var(--panel-border);
  padding: 14px 20px; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); transform: translateY(150%); transition: var(--transition); font-size: 13px;
}
.toast.show { transform: translateY(0); }
.toast b { display: block; color: var(--gold-light); margin-bottom: 2px; }

@media (max-width: 850px) { .shop-container { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<canvas id="particleCanvas"></canvas>

<div class="app">
  <nav class="nav">
    <div class="brand">
      <div class="logo" id="adminLogoBtn" title="Yönetici Girişi">M</div>
      <div>
        <h1 style="font-size: 16px; letter-spacing: 0.15em;">MAMI WORKS</h1>
        <span style="font-size: 10px; color: var(--gold-primary); letter-spacing: 0.2em;">DESIGN & AUTOMOTIVE LOGO STORE</span>
      </div>
    </div>
    <div class="nav-actions">
      <button class="theme-toggle" id="themeBtn">🌙 Koyu Tema</button>
    </div>
  </nav>

  <section class="hero">
    <div class="eyebrow">MAMI WORKS CREATIVE STUDIO</div>
    <h2 style="font-size: 28px; font-weight: 800;">Özel Araç Tasarımları & Vektörel Logolar</h2>
    <p style="color: var(--text-muted); font-size: 14px; margin-top: 6px;">Projelerinize özel illüstrasyon ve livery grafik tasarımları doğrudan sipariş verin.</p>
  </section>

  <main class="shop-container">
    <section class="card">
      <div class="card-head">
        <h3 style="font-size: 18px; font-weight: 700;">Tasarım Kataloğu</h3>
        <p style="color: var(--text-muted); font-size: 12px;">Sipariş etmek istediğiniz tasarımı seçiniz.</p>
      </div>
      <div class="products-grid" id="productsGrid"></div>
    </section>

    <aside class="card">
      <div class="card-head">
        <h3 style="font-size: 18px; font-weight: 700;">Sipariş Formu</h3>
        <p style="color: var(--text-muted); font-size: 12px;">Proje detaylarınızı eksiksiz doldurun.</p>
      </div>

      <div class="field">
        <label>Seçilen Tasarım</label>
        <input type="text" id="selectedProductTitle" value="Lütfen bir tasarım seçin" readonly>
      </div>

      <div class="field">
        <label>Tutar (TL)</label>
        <input type="text" id="selectedProductPrice" value="0 TL" readonly>
      </div>

      <div class="field">
        <label>Adınız Soyadınız *</label>
        <input type="text" id="custName" placeholder="Ad Soyad giriniz...">
